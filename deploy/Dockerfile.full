ARG PYTHON_IMAGE=python:3.13.5-slim-bookworm
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN python -m pip install --no-cache-dir '.[bridge,workflow,postgres,security,mcp,observability,deployment]' && python -m pip check \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin app
USER 10001:10001
EXPOSE 8000
CMD ["python","-m","uvicorn","a2a_mq.application:from_env","--factory","--host","0.0.0.0","--port","8000","--no-access-log","--timeout-graceful-shutdown","60"]
