{
  "schemaVersion": 1,
  "binding": "A2A",
  "protocolVersion": "1.0",
  "sdk": {
    "package": "a2a-sdk",
    "version": "1.1.2"
  },
  "discovery": {
    "agentCardPath": "/.well-known/agent-card.json",
    "authenticatedExtendedCard": true
  },
  "interfaces": [
    {
      "protocolBinding": "JSONRPC",
      "path": "/rpc",
      "protocolVersion": "1.0"
    },
    {
      "protocolBinding": "HTTP+JSON",
      "path": "/",
      "protocolVersion": "1.0"
    }
  ],
  "authentication": {
    "scheme": "Bearer",
    "format": "JWT",
    "algorithms": ["RS256"],
    "tenantAuthority": "verified-principal"
  },
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": true
  },
  "operations": {
    "message/send": "implemented",
    "message/stream": "implemented",
    "tasks/get": "implemented",
    "tasks/list": "implemented",
    "tasks/cancel": "implemented",
    "tasks/subscribe": "implemented",
    "agent/getAuthenticatedExtendedCard": "implemented",
    "tasks/pushNotification/create": "unsupported",
    "tasks/pushNotification/get": "unsupported",
    "tasks/pushNotification/list": "unsupported",
    "tasks/pushNotification/delete": "unsupported"
  },
  "extensions": {
    "approvalPath": "/operations/tasks/{task_id}/approve",
    "mcpIsSeparateProtocolSurface": true,
    "operationsApiIsSeparateAdministrativeSurface": true
  }
}
