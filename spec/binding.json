{
  "schemaVersion": 1,
  "binding": "A2A",
  "protocolVersion": "1.0",
  "sdk": {
    "package": "a2a-sdk",
    "version": "1.1.5"
  },
  "discovery": {
    "agentCardPath": "/.well-known/agent-card.json",
    "authenticatedExtendedCard": true
  },
  "interfaces": [
    {
      "protocolBinding": "JSONRPC",
      "path": "/rpc",
      "protocolVersion": "1.0"
    },
    {
      "protocolBinding": "HTTP+JSON",
      "path": "/",
      "protocolVersion": "1.0"
    }
  ],
  "authentication": {
    "scheme": "Bearer",
    "format": "JWT",
    "algorithms": [
      "RS256"
    ],
    "tenantAuthority": "verified-principal"
  },
  "capabilities": {
    "streaming": true,
    "pushNotifications": false,
    "extendedAgentCard": true
  },
  "operations": {
    "SendMessage": "implemented",
    "SendStreamingMessage": "implemented",
    "GetTask": "implemented",
    "ListTasks": "implemented",
    "CancelTask": "implemented",
    "SubscribeToTask": "implemented",
    "GetExtendedAgentCard": "implemented",
    "CreateTaskPushNotificationConfig": "unsupported",
    "GetTaskPushNotificationConfig": "unsupported",
    "ListTaskPushNotificationConfigs": "unsupported",
    "DeleteTaskPushNotificationConfig": "unsupported"
  },
  "extensions": {
    "approvalPath": "/operations/tasks/{task_id}/approve",
    "mcpIsSeparateProtocolSurface": true,
    "operationsApiIsSeparateAdministrativeSurface": true
  }
}
