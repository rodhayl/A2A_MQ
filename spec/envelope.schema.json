{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:a2a-mq:envelope:1.0","title":"A2A-MQ envelope 1.0","type":"object","additionalProperties":false,"required":["envelopeVersion","a2aVersion","tenantId","messageId","kind","operation","source","correlationId","createdAt","payload"],"properties":{"envelopeVersion":{"const":"1.0"},"a2aVersion":{"const":"1.0"},"tenantId":{"$ref":"#/$defs/token"},"messageId":{"type":"string","format":"uuid"},"source":{"$ref":"#/$defs/token"},"kind":{"enum":["command","event"]},"operation":{"enum":["message.send","task.snapshot","task.status","task.artifact"]},"target":{"oneOf":[{"type":"object","required":["agentId"],"properties":{"agentId":{"$ref":"#/$defs/token"}},"additionalProperties":false},{"type":"object","required":["skill"],"properties":{"skill":{"$ref":"#/$defs/token"}},"additionalProperties":false}]},"taskId":{"$ref":"#/$defs/id"},"contextId":{"$ref":"#/$defs/id"},"correlationId":{"$ref":"#/$defs/id"},"causationId":{"$ref":"#/$defs/id"},"sequence":{"type":"integer","minimum":1,"maximum":9007199254740991},"createdAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"traceparent":{"type":"string","pattern":"^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"},"tracestate":{"type":"string","maxLength":512},"contentType":{"const":"application/json"},"contentEncoding":{"const":"identity"},"payload":{"type":"object"},"extensions":{"type":"object"}},"allOf":[{"if":{"properties":{"kind":{"const":"command"}}},"then":{"required":["target"],"properties":{"operation":{"const":"message.send"}},"not":{"required":["sequence"]}},"else":{"required":["taskId","contextId","sequence","causationId"],"properties":{"operation":{"enum":["task.snapshot","task.status","task.artifact"]}},"not":{"required":["target"]}}}],"$defs":{"token":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{0,62}$"},"id":{"type":"string","minLength":1,"maxLength":256}}}
