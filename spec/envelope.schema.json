{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a2a-mq/envelope.schema.json",
  "title": "A2A-MQ Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "envelopeVersion",
    "a2aVersion",
    "messageId",
    "operation",
    "kind",
    "source",
    "target",
    "correlationId",
    "sequence",
    "createdAt",
    "contentType"
  ],
  "properties": {
    "envelopeVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "a2aVersion": {
      "type": "string",
      "minLength": 1
    },
    "messageId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "operation": {
      "type": "string",
      "enum": [
        "message.send",
        "task.get",
        "task.list",
        "task.cancel",
        "task.continue",
        "task.status",
        "task.artifact",
        "agent.changed"
      ]
    },
    "kind": {
      "type": "string",
      "enum": ["command", "event", "reply"]
    },
    "source": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "skill": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "anyOf": [
        {"required": ["agentId"]},
        {"required": ["skill"]}
      ]
    },
    "taskId": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "contextId": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "causationId": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "traceparent": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "tracestate": {
      "type": ["string", "null"],
      "maxLength": 1024
    },
    "contentType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contentEncoding": {
      "type": "string",
      "enum": ["identity", "encrypted"]
    },
    "encryption": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/encryption"}
      ]
    },
    "payload": {},
    "ciphertext": {
      "type": "string",
      "contentEncoding": "base64"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"contentEncoding": {"const": "encrypted"}},
        "required": ["contentEncoding"]
      },
      "then": {
        "required": ["encryption", "ciphertext"],
        "not": {"required": ["payload"]}
      },
      "else": {
        "required": ["payload"]
      }
    }
  ],
  "$defs": {
    "encryption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "keyManagement", "keyId", "wrappedKey", "nonce", "aadProfile"],
      "properties": {
        "alg": {"const": "A256GCM"},
        "keyManagement": {
          "type": "string",
          "enum": ["KMS-WRAP", "DEV-STATIC-WRAP"]
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "wrappedKey": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "nonce": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "aadProfile": {"const": "a2a-mq-v1"}
      }
    }
  }
}
