          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "command": [
                  "python",
                  "-m",
                  "uvicorn",
                  "a2a_mq.production_env:create_api_from_env",
                  "--factory",
                  "--host",
                  "0.0.0.0",
                  "--port",
                  "8000",
                  "--no-access-log",
                  "--limit-concurrency",
                  "256"
                ],
                "env": [
                  {
                    "name": "A2A_TENANT",
                    "value": "prod-tenant"
                  },
                  {
                    "name": "A2A_PUBSUB_COMPONENT",
                    "value": "bus-prod-tenant-api"
                  },
                  {
                    "name": "A2A_POSTGRES_DSN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "dsn",
                        "name": "a2amq-postgres"
                      }
                    }
                  },
                  {
                    "name": "DAPR_HTTP_ENDPOINT",
                    "value": "http://127.0.0.1:3500"
                  },
                  {
                    "name": "DAPR_API_TOKEN",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "token",
                        "name": "dapr-api-token"
                      }
                    }
                  },
                  {
                    "name": "A2A_CONSUMER",
                    "value": "workflow-worker"
                  },
                  {
                    "name": "A2A_DLQ_CONSUMER",
                    "value": "operations"
                  },
                  {
                    "name": "A2A_PUBLIC_URL",
                    "value": "https://127.0.0.1:31443"
                  },
                  {
                    "name": "A2A_MCP_RESOURCE_URL",
                    "value": "https://127.0.0.1:31443/mcp"
                  },
                  {
                    "name": "A2A_JWT_KID",
                    "value": "prod-key-1"
                  },
                  {
                    "name": "A2A_JWT_ISSUER",
                    "value": "https://a2amq-idp.internal"
                  },
                  {
                    "name": "A2A_JWT_PUBLIC_KEY_FILE",
                    "value": "/etc/a2amq/jwt/public.pem"
                  }
                ],
                "image": "a2amq-prod:6458195-ca@sha256:a54c969183a0c314c77df93c7761db53de19dea8da9e9b20ddebccec425958af",
                "imagePullPolicy": "IfNotPresent",
                "livenessProbe": {
                  "failureThreshold": 3,
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8000
                  },
                  "periodSeconds": 20,
                  "timeoutSeconds": 3
                },
                "name": "app",
                "ports": [
                  {
                    "containerPort": 8000,
                    "name": "http"
                  }
                ],
                "readinessProbe": {
                  "failureThreshold": 6,
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8000
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "512Mi"
                  },
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true,
                  "runAsNonRoot": true,
                  "runAsUser": 10001
                },
                "volumeMounts": [
                  {
                    "mountPath": "/etc/a2amq/jwt",
                    "name": "jwt",
                    "readOnly": true
                  }
                ]
              }
            ],
            "securityContext": {
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "volumes": [
              {
                "configMap": {
                  "items": [
                    {
                      "key": "public.pem",
                      "path": "public.pem"
                    }
                  ],
                  "name": "a2amq-jwt-public-key"
                },
                "name": "jwt"
              }
            ]
